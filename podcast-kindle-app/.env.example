# Podcast Index API (Free with registration at https://podcastindex.org)
PODCAST_INDEX_KEY=your_key_here
PODCAST_INDEX_SECRET=your_secret_here

# Listen Notes API (Optional - https://www.listennotes.com/api/)
LISTEN_NOTES_KEY=optional

# Flask Configuration
FLASK_SECRET_KEY=generate_random_key_here
FLASK_ENV=production

# Rate Limiting
MAX_EPISODES_PER_SESSION=5
CACHE_DURATION_HOURS=24

# Processing Timeouts
PROCESSING_TIMEOUT_MINUTES=2
